rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Projet `la-revue-du-luxe` (La Revue du Luxe), créé le 19/10/2026.
    // Les runners (scraper, social-runner, Vercel) passent par le SDK admin,
    // qui ignore ces règles. Elles ne concernent que le hub (SDK web, connecté).

    // Jeton LinkedIn : hors de portée de tout client.
    match /linkedin_auth_lrdl/{doc} { allow read, write: if false; }

    // Files et brouillons édités depuis le hub : connexion requise, comme ailleurs.
    match /news_drafts_auto/{doc} { allow read, write: if request.auth != null; }
    match /linkedin_queue/{doc}   { allow read, write: if request.auth != null; }
    match /instagram_queue/{doc}  { allow read, write: if request.auth != null; }

    // Tout le reste (scraped_urls, news, app_config) reste fermé.
    match /{document=**} { allow read, write: if false; }
  }
}
